# --- Reistijd / geocoding provider -------------------------------------------
# "osm"  = Nominatim (geocoding) + OSRM (routing). Gratis, geen API-key nodig.
# "ors"  = OpenRouteService. Nauwkeuriger, vereist een gratis API-key.
TRAVEL_PROVIDER=osm

# Alleen nodig wanneer TRAVEL_PROVIDER=ors
# Gratis key aanvragen op https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Nominatim vraagt om een identificeerbare User-Agent met contact-adres.
NOMINATIM_USER_AGENT="VertrektijdAgenda/0.1 (contact: jouw@email.nl)"

# Optioneel: eigen Nominatim/OSRM instantie
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# OSRM_BASE_URL=https://router.project-osrm.org

# --- OV, fiets en lopen -------------------------------------------------------
# MOTIS/transitous levert OV-reizen (met lijnen, overstappen en sporen) en
# realistische fiets-/looproutes. Gratis en zonder sleutel, maar wel met een
# herkenbare User-Agent (zie NOMINATIM_USER_AGENT hierboven, die wordt hergebruikt).
# Gebruiksvoorwaarden: https://transitous.org/api/
# MOTIS_BASE_URL=https://api.transitous.org

# --- Account & synchronisatie (optioneel) -------------------------------------
# Vul deze in met je gratis Supabase-project om login + cloud-sync te activeren.
# Beide waarden zijn publiek (de anon key hoort in de client, beschermd door RLS).
# Leeg laten = app werkt lokaal zonder account.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Meldingen met de app dicht (optioneel) -----------------------------------
# Maak het sleutelpaar zelf aan met:  npx web-push generate-vapid-keys
# De publieke helft hoort in de browser, de geheime helft NOOIT (geen
# NEXT_PUBLIC_-prefix). Zet die alleen in de serverinstellingen van je hosting.
# Vereist ook SUPABASE_SERVICE_ROLE_KEY en de tabellen uit SUPABASE-SETUP.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Waar de push-diensten je kunnen bereiken bij problemen, bv. mailto:jij@voorbeeld.nl
VAPID_CONTACT=
# Zelfverzonnen lang geheim; alleen de klok in Supabase kent dit.
PUSH_CRON_SECRET=
